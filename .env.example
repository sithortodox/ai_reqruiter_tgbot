# --- Telegram ---
BOT_TOKEN=
# ID администраторов через запятую, например 111111111,222222222
ADMIN_IDS=
# ID закрытого чата рекрутеров (создайте чат, добавьте бота и укажите id)
RECRUITERS_CHAT_ID=

# --- База данных ---
# Для продакшена: postgresql+asyncpg://bot:bot@db:5432/bot
# Для разработки:  sqlite+aiosqlite:///./dev.db
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- LLM (OpenAI-совместимый API) ---
LLM_PROVIDER=openai_compat
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
# Лимит текста резюме/ответов, передаваемого в LLM (символы)
LLM_MAX_INPUT_CHARS=12000
# Цены за 1K токенов для расчёта стоимости вызова (можно оставить пустыми)
LLM_PRICE_INPUT_PER_1K=
LLM_PRICE_OUTPUT_PER_1K=

# --- Интервью ---
INTERVIEW_TIMEOUT_MINUTES=60
INTERVIEW_REMINDER_MINUTES=30
MAX_MESSAGE_LENGTH=4000
MAX_RESUME_SIZE_MB=10

# --- Персональные данные ---
# Срок хранения ПД в днях от даты завершения сессии; затем автоочистка
RETENTION_DAYS=365
# Шифрование контактов в БД (пер base64 от 32 байт, например:
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
ENCRYPTION_KEY=

# --- Доступ к веб-панели ---
ADMIN_USERNAME=admin
ADMIN_PANEL_PASSWORD=

# --- Вакансии и маршрутизация ---
DEFAULT_VACANCY_ID=
DEFAULT_SCORE_THRESHOLD=7

# --- Админ-панель (веб) ---
ADMIN_WEB_ENABLED=true
ADMIN_WEB_PORT=8080
# Секрет для подписи сессий; если пусто, выводится из BOT_TOKEN
PANEL_SECRET=

# --- Логирование ---
LOG_LEVEL=INFO
# Часовой пояс для отчётов, например Europe/Moscow
TZ_NAME=UTC